# Copy the value into your shell environment. Do not commit a real key.
DEEPSEEK_API_KEY=replace-with-a-new-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Conservative automatic-confirmation thresholds
AUTO_LOCAL_SCORE=0.95
AUTO_AI_CONFIDENCE=0.90
AUTO_SCORE_MARGIN=0.15
